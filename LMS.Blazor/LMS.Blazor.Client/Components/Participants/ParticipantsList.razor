@using LMS.Shared.DTOs.Course

@if (IsLoading)
{
    <div class="alert alert-info">Laddar deltagare...</div>
}
else if (Participants is null || Participants.Count == 0)
{
    <div class="alert alert-warning">Inga deltagare hittades.</div>
}
else
{
    <ul class="list-group mt-3">
        @foreach (var p in Participants)
        {
            <li class="list-group-item d-flex justify-content-between">
                <span>@p.FullName</span>
                <span class="text-muted">@p.Email</span>
            </li>
        }
    </ul>
}

@code {
    [Parameter] public List<ParticipantDto>? Participants { get; set; }
    [Parameter] public bool IsLoading { get; set; }
}