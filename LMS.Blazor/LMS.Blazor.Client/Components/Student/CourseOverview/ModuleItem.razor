@namespace LMS.Blazor.Client.Components.CourseOverview
@using LMS.Shared.DTOs.Activity
@using LMS.Shared.DTOs.Document
@using LMS.Shared.DTOs.Module
@using LMS.Shared.DTOs.Submission

<div class="list-group-item list-group-item">
    <div class="d-flex justify-content-between align-items-start @GetHeaderSpacingClass()"
         role="button"
         @onclick="ToggleExpandModule">

        <div>

            <div class="d-flex justify-content-between align-items-start mb-2">
                <h3 class="h4 mb-0">
                    <i class="bi bi-book h4 pe-2 text-primary"></i>
                    @Module.Name
                </h3>

                <span class="small text-muted ms-3">
                    @Module.Progress %
                </span>
            </div>

            <div class="progress mb-2" style="height: 6px;">
                <div class="progress-bar"
                     role="progressbar"
                     style="width: @Module.Progress%;"
                     aria-valuenow="@Module.Progress"
                     aria-valuemin="0"
                     aria-valuemax="100">
                </div>
            </div>

            <p class="text-muted mb-0">
                <i class="bi bi-calendar"></i>
                @Module.DateRange
            </p>
        </div>

        <!-- Hmmm -->
        @if (Module.Progress == 100) {
        <div class="d-flex align-items-center justify-content-end gap-2">
            <span class="bg-success-subtle text-success rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                <i class="bi bi-check-circle"></i>
            </span>
            <span>Genomförd</span>
        </div>
        }


    </div>

    @if (isExpanded)
    {
        <p class="text-muted mb-3">@Module.Description</p>

        <!-- Module-level documents for students -->
        @if (ModuleDocuments?.Any() == true)
        {
            <div class="mb-3">
                <h5 class="h6 fw-semibold text-secondary mb-2">
                    <i class="bi bi-folder2-open me-1"></i>
                    Moduldokument
                </h5>
                <DocumentList Documents="@ModuleDocuments" CanDelete="false" />
            </div>
        }

        <h4 class="h5 mb-3">Aktiviteter</h4>

        <div class="list-group list-group-flush border rounded">
            @foreach (var activity in Module.Activities)
            {
                var submission = Submissions?.FirstOrDefault(s => s.ActivityId == activity.Id);
                <ActivityItem Activity="activity"
                              Submission="submission"
                              Documents="@GetActivityDocs(activity.Id)" />
            }

            @if (!Module.Activities.Any())
            {
                <div class="list-group-item py-3">
                    <p>Inga aktiviteter tillagda än</p>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public ModuleDto Module { get; set; }
    [Parameter] public List<DocumentDto>? ModuleDocuments { get; set; }
    [Parameter] public Dictionary<int, List<DocumentDto>>? ActivityDocuments { get; set; }
    [Parameter] public List<SubmissionDto>? Submissions { get; set; }

    private bool isExpanded;

    private string GetHeaderSpacingClass() => isExpanded ? "mb-3" : "mb-0";

    private void ToggleExpandModule()
    {
        isExpanded = !isExpanded;
    }

    private List<DocumentDto>? GetActivityDocs(int activityId)
    {
        if (ActivityDocuments != null && ActivityDocuments.TryGetValue(activityId, out var docs))
            return docs;
        return null;
    }
}