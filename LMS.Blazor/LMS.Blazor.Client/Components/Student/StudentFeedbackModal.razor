@if (Show && Assignment != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Feedback från läraren</h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>

                <div class="modal-body">

                    <p><strong>Uppgift:</strong> @Assignment.Name</p>

                    @if (Assignment.FeedbackGivenAt.HasValue)
                    {
                        <p>
                            <strong>Lämnades:</strong>
                            @Assignment.FeedbackGivenAt.Value.ToString("yyyy-MM-dd HH:mm")
                            @if (!string.IsNullOrWhiteSpace(Assignment.FeedbackGivenByTeacherName))
                            {
                                <span class="text-muted"> av @Assignment.FeedbackGivenByTeacherName</span>
                            }
                        </p>
                    }

                    <div class="border rounded p-3 bg-light">
                        @Assignment.Feedback
                    </div>

                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="Close">Stäng</button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    [Parameter] public StudentAssignmentDto? Assignment { get; set; }
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task Close()
    {
        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();
    }
}
