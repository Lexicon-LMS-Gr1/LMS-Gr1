<div class="modal fade @(IsVisible ? "show d-block" : "")" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">@Title</h5>
                <button type="button" class="btn-close" @onclick="Cancel"></button>
            </div>

            <div class="modal-body">
                <p>@Message</p>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="Cancel">Avbryt</button>
                <button class="btn btn-danger" @onclick="Confirm">Ta bort</button>
            </div>

        </div>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Bekräfta";
    [Parameter] public string Message { get; set; } = "Är du säker?";
    [Parameter] public EventCallback<bool> OnClose { get; set; }

    public bool IsVisible { get; private set; }

    public void Show()
    {
        IsVisible = true;
        StateHasChanged();
    }

    private async Task Confirm()
    {
        IsVisible = false;
        await OnClose.InvokeAsync(true);
    }

    private async Task Cancel()
    {
        IsVisible = false;
        await OnClose.InvokeAsync(false);
    }
}
