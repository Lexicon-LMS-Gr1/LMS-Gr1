@using LMS.Shared.DTOs.Course
@using LMS.Shared.DTOs.Module
@using LMS.Shared.DTOs.Activity
@using LMS.Shared.DTOs.Document
@using LMS.Blazor.Client.Components.Shared
@inject IApiService ApiService

<div class="container py-4">

    @if (OnBack.HasDelegate) {
        <button class="btn btn-outline-secondary mb-3"
                @onclick="() => OnBack.InvokeAsync()">
            <i class="bi bi-arrow-left"></i> Tillbaka
        </button>
    }

    @if (Course == null) {
        <p>Laddar...</p>
    }
    else
    {
        <!-- ══ COURSE HEADER ══════════════════════════════════════════════════ -->
        <h2>@Course.Name</h2>
        <p class="text-muted">@Course.Description</p>

        <!-- Course-level documents -->
        <DocumentList Documents="courseDocuments"
                      CanDelete="true"
                      OnDeleted="id => DeleteDocument(id, reload: LoadCourseDocumentsAsync)" />

        <!-- Upload button – course level -->
        <button class="btn btn-sm btn-outline-secondary mt-2 mb-4 d-flex align-items-center gap-1"
                @onclick="() => OpenUploadModal(courseId: Course.Id)">
            <i class="bi bi-paperclip"></i> Ladda upp dokument till kursen
        </button>

        <!-- ══ MODULES ════════════════════════════════════════════════════════ -->
        <div class="d-flex justify-content-between align-items-center mt-2 mb-3">
            <h4 class="mb-0">Moduler</h4>
            <button class="btn btn-primary d-flex align-items-center"
                    @onclick="OpenCreateModuleModal">
                <i class="bi bi-plus-circle me-2"></i>
                Skapa ny modul
            </button>
        </div>

        @foreach (var module in Course.Modules) {

            <!-- MODULE CARD -->
            <div class="card mb-3"
                 style="cursor:pointer;"
                 @onclick="() => ToggleModule(module.Id)">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h5 class="mb-1">@module.Name</h5>
                            <p class="text-muted mb-1">@module.Description</p>
                            <p class="small text-secondary mb-0">
                                @module.StartDate.ToString("yyyy-MM-dd") –
                                @module.EndDate.ToString("yyyy-MM-dd")
                            </p>
                        </div>
                        <button class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1"
                                @onclick:stopPropagation="true"
                                @onclick="() => OpenModuleModal(module)">
                            <i class="bi bi-pencil"></i> Edit
                        </button>
                    </div>

                    <!-- Module-level documents (always visible) -->
                    @if (moduleDocuments.TryGetValue(module.Id, out var modDocs))
                    {
                        <DocumentList Documents="modDocs"
                                      CanDelete="true"
                                      OnDeleted="id => DeleteDocument(id, reload: () => LoadModuleDocumentsAsync(module.Id))" />
                    }

                    <!-- Upload button – module level -->
                    <button class="btn btn-sm btn-outline-secondary mt-2 d-flex align-items-center gap-1"
                            @onclick:stopPropagation="true"
                            @onclick="() => OpenUploadModal(moduleId: module.Id)">
                        <i class="bi bi-paperclip"></i> Ladda upp dokument till modulen
                    </button>
                </div>
            </div>

            <!-- ACTIVITIES (expanded) -->
            @if (openModuleId == module.Id) {
                <div class="ms-4 mb-3">
                    @if (module.Activities?.Any() == true) {
                        <h6 class="mb-3">Aktiviteter</h6>

                        @foreach (var a in module.Activities.OrderBy(a => a.StartTime)) {
                            <div class="card mb-2">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-primary">@a.ActivityTypeName</span>
                                                <strong>@a.Name</strong>
                                            </div>

                                            <div class="text-muted small mt-1">
                                                @if (a.StartTime.Date == a.EndTime.Date) {
                                                    @a.StartTime.ToString("yyyy-MM-dd")
                                                } else {
                                                    @($"{a.StartTime:yyyy-MM-dd} - {a.EndTime:yyyy-MM-dd}")
                                                }
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(a.Description)) {
                                                <div class="mt-2 small text-muted">@a.Description</div>
                                            }

                                            @if (a.DueDate.HasValue) {
                                                <div class="mt-1 small">
                                                    <strong>Deadline:</strong>
                                                    @a.DueDate.Value.ToString("yyyy-MM-dd")
                                                </div>
                                            }

                                            <!-- Activity-level documents (always visible) -->
                                            @if (activityDocuments.TryGetValue(a.Id, out var actDocs))
                                            {
                                                <DocumentList Documents="actDocs"
                                                              CanDelete="true"
                                                              OnDeleted="id => DeleteDocument(id, reload: () => LoadActivityDocumentsAsync(a.Id))" />
                                            }

                                            <!-- Upload button – activity level -->
                                            <button class="btn btn-sm btn-outline-secondary mt-2 d-flex align-items-center gap-1"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => OpenUploadModal(activityId: a.Id)">
                                                <i class="bi bi-paperclip"></i> Ladda upp dokument till aktiviteten
                                            </button>
                                        </div>

                                        <div class="d-flex align-items-center gap-2 ms-3">
                                            <button class="btn btn-sm btn-outline-primary"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => OpenActivityModal(a)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger"
                                                    @onclick:stopPropagation="true">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    } else {
                        <p class="text-muted small">Inga aktiviteter.</p>
                    }
                </div>
            }
        }
    }
</div>

<!-- ══ CREATE MODULE MODAL ═══════════════════════════════════════════════════ -->
@if (showCreateModuleModal && Course != null)
{
    <CreateModuleModal CourseId="@CourseId"
                       CourseStartDate="@Course?.StartDate"
                       CourseEndDate="@Course?.EndDate"
                       ExistingModules="@Course?.Modules"
                       OnCreated="HandleModuleCreated"
                       OnClose="CloseCreateModuleModal" />
}

<!-- ══ EDIT ACTIVITY MODAL ═══════════════════════════════════════════════════ -->
@if (showActivityModal) {
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit activity</h5>
                    <button type="button" class="btn-close" @onclick="CloseActivityModal"></button>
                </div>
                <EditForm EditContext="activityEditContext" OnValidSubmit="SaveActivity">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(activityError)) {
                            <div class="alert alert-danger">@activityError</div>
                        }
                        <div class="mb-3">
                            <label class="form-label">Namn</label>
                            <InputText class="form-control" @bind-Value="activityForm.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Beskrivning</label>
                            <InputTextArea class="form-control" @bind-Value="activityForm.Description" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Start</label>
                            <InputDate class="form-control" @bind-Value="activityForm.StartTime" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Slut</label>
                            <InputDate class="form-control" @bind-Value="activityForm.EndTime" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Deadline</label>
                            <div class="d-flex gap-2">
                                <InputDate class="form-control" @bind-Value="activityForm.DueDate" />
                                <button type="button" class="btn btn-outline-danger" title="Ta bort deadline" @onclick="ClearDeadline">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseActivityModal">Stäng</button>
                        <button type="submit" class="btn btn-primary">Spara</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

<!-- ══ EDIT MODULE MODAL ══════════════════════════════════════════════════════ -->
@if (showModuleModal) {
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit module</h5>
                    <button type="button" class="btn-close" @onclick="CloseModuleModal"></button>
                </div>
                <EditForm EditContext="moduleEditContext" OnValidSubmit="SaveModule">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(moduleError)) {
                            <div class="alert alert-danger">@moduleError</div>
                        }
                        <div class="mb-3">
                            <label class="form-label">Namn</label>
                            <InputText class="form-control" @bind-Value="moduleForm.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Beskrivning</label>
                            <InputTextArea class="form-control" @bind-Value="moduleForm.Description" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Startdatum</label>
                            <InputDate class="form-control" @bind-Value="moduleForm.StartDate" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Slutdatum</label>
                            <InputDate class="form-control" @bind-Value="moduleForm.EndDate" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CloseModuleModal">Stäng</button>
                        <button type="submit" class="btn btn-primary">Spara</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

<!-- ══ DOCUMENT UPLOAD MODAL ══════════════════════════════════════════════════ -->
@if (showUploadModal)
{
    <DocumentUploadModal CourseId="@uploadCourseId"
                         ModuleId="@uploadModuleId"
                         ActivityId="@uploadActivityId"
                         OnUploaded="HandleDocumentUploaded"
                         OnClose="CloseUploadModal" />
}

@code {
    [Parameter] public int CourseId { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private CourseDto? Course;
    private int? openModuleId;

    // ── Document state ────────────────────────────────────────────────────────
    private List<DocumentDto> courseDocuments = new();
    private Dictionary<int, List<DocumentDto>> moduleDocuments   = new();
    private Dictionary<int, List<DocumentDto>> activityDocuments = new();

    // ── Upload modal ──────────────────────────────────────────────────────────
    private bool showUploadModal;
    private int? uploadCourseId;
    private int? uploadModuleId;
    private int? uploadActivityId;

    // ── Activity edit ─────────────────────────────────────────────────────────
    private bool showActivityModal;
    private UpdateActivityDto activityForm = new();
    private string? activityError;
    private EditContext? activityEditContext;

    // ── Module edit ───────────────────────────────────────────────────────────
    private bool showModuleModal;
    private ModuleUpdateDto moduleForm = new();
    private string? moduleError;
    private EditContext? moduleEditContext;

    // ── Create module ─────────────────────────────────────────────────────────
    private bool showCreateModuleModal;

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnParametersSetAsync()
    {
        await LoadCourseAsync();
    }

    private async Task LoadCourseAsync()
    {
        Course = await ApiService.GetAsync<CourseDto>($"api/course/{CourseId}");
        await LoadAllDocumentsAsync();
    }

    // ── Document loading ──────────────────────────────────────────────────────
    private async Task LoadAllDocumentsAsync()
    {
        if (Course == null) return;

        await LoadCourseDocumentsAsync();

        foreach (var module in Course.Modules)
        {
            await LoadModuleDocumentsAsync(module.Id);

            if (module.Activities != null)
                foreach (var activity in module.Activities)
                    await LoadActivityDocumentsAsync(activity.Id);
        }
    }

    private async Task LoadCourseDocumentsAsync()
    {
        courseDocuments = await ApiService.GetAsync<List<DocumentDto>>($"api/documents?courseId={CourseId}")
                          ?? new();
    }

    private async Task LoadModuleDocumentsAsync(int moduleId)
    {
        var docs = await ApiService.GetAsync<List<DocumentDto>>($"api/documents?moduleId={moduleId}")
                   ?? new();
        moduleDocuments[moduleId] = docs;
    }

    private async Task LoadActivityDocumentsAsync(int activityId)
    {
        var docs = await ApiService.GetAsync<List<DocumentDto>>($"api/documents?activityId={activityId}")
                   ?? new();
        activityDocuments[activityId] = docs;
    }

    // ── Upload modal handlers ─────────────────────────────────────────────────
    private void OpenUploadModal(int? courseId = null, int? moduleId = null, int? activityId = null)
    {
        uploadCourseId   = courseId;
        uploadModuleId   = moduleId;
        uploadActivityId = activityId;
        showUploadModal  = true;
    }

    private void CloseUploadModal()
    {
        showUploadModal  = false;
        uploadCourseId   = null;
        uploadModuleId   = null;
        uploadActivityId = null;
    }

    private async Task HandleDocumentUploaded(DocumentDto doc)
    {
        showUploadModal = false;

        // Refresh only the relevant document list
        if (doc.CourseId.HasValue)    await LoadCourseDocumentsAsync();
        if (doc.ModuleId.HasValue)    await LoadModuleDocumentsAsync(doc.ModuleId.Value);
        if (doc.ActivityId.HasValue)  await LoadActivityDocumentsAsync(doc.ActivityId.Value);
    }

    private async Task DeleteDocument(int documentId, Func<Task> reload)
    {
        var (success, _) = await ApiService.DeleteAsync($"api/documents/{documentId}");
        if (success)
            await reload();
    }

    // ── Module toggle ─────────────────────────────────────────────────────────
    private void ToggleModule(int moduleId)
    {
        openModuleId = openModuleId == moduleId ? null : moduleId;
    }

    // ── Activity modal ────────────────────────────────────────────────────────
    private void OpenActivityModal(ActivityDto activity)
    {
        activityForm = new UpdateActivityDto {
            Id          = activity.Id,
            Name        = activity.Name,
            Description = activity.Description,
            StartTime   = activity.StartTime,
            EndTime     = activity.EndTime,
            DueDate     = activity.DueDate
        };
        activityEditContext = new EditContext(activityForm);
        activityError = null;
        showActivityModal = true;
    }

    private void CloseActivityModal()
    {
        showActivityModal = false;
        activityError = null;
    }

    private async Task SaveActivity()
    {
        activityError = null;
        try {
            var result = await ApiService.PutAsync<UpdateActivityDto, ActivityDto>(
                $"api/activity/{activityForm.Id}", activityForm);
            if (result != null) {
                showActivityModal = false;
                await LoadCourseAsync();
            } else {
                activityError = "Kunde inte uppdatera aktiviteten.";
            }
        } catch (Exception ex) {
            activityError = ex.Message;
        }
    }

    private void ClearDeadline() => activityForm.DueDate = null;

    // ── Module modal ──────────────────────────────────────────────────────────
    private void OpenModuleModal(ModuleDto module)
    {
        moduleForm = new ModuleUpdateDto {
            Id          = module.Id,
            Name        = module.Name,
            Description = module.Description,
            StartDate   = module.StartDate,
            EndDate     = module.EndDate,
            CourseId    = CourseId
        };
        moduleEditContext = new EditContext(moduleForm);
        moduleError = null;
        showModuleModal = true;
    }

    private void CloseModuleModal()
    {
        showModuleModal = false;
        moduleError = null;
    }

    private async Task SaveModule()
    {
        moduleError = null;
        try {
            var result = await ApiService.PutAsync<ModuleUpdateDto, ModuleDto>(
                $"api/module/{moduleForm.Id}", moduleForm);
            if (result != null) {
                showModuleModal = false;
                await LoadCourseAsync();
            } else {
                moduleError = "Kunde inte uppdatera modulen.";
            }
        } catch (Exception ex) {
            moduleError = ex.Message;
        }
    }

    // ── Create module modal ───────────────────────────────────────────────────
    private void OpenCreateModuleModal()   => showCreateModuleModal = true;
    private Task CloseCreateModuleModal()  { showCreateModuleModal = false; return Task.CompletedTask; }
    private async Task HandleModuleCreated() { showCreateModuleModal = false; await LoadCourseAsync(); }
}