@using LMS.Blazor.Client.Services
@using LMS.Blazor.Client.Models
@using LMS.Shared.DTOs.Course
@using LMS.Shared.DTOs.Module
@using Microsoft.AspNetCore.Components.Forms
@inject IApiService ApiService

<div class="card shadow-sm border-0">
    <div class="card-body @(IsModal ? "p-2 pt-0" : "p-4")">

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }
        
         @if (!IsModal) // Egen heading om komponenten visas i eget fönster
          {
            <h5 class="modal-title">
                <span class="position-relative me-3">
                    <i class="bi bi-book fs-5"></i>
                    <i class="bi bi-plus-circle position-absolute top-0 start-100 translate-middle fs-6 bg-white rounded-circle"></i>
                </span>
                Skapa kurs
            </h5>
          }        

        <EditForm EditContext="courseEditContext" OnSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            @* <h2 class="h5 mb-3">Kurs</h2> *@

            <div class="mb-3 mt-3">
                <label class="form-label fw-semibold">Kursnamn</label>
                <InputText class="form-control" @bind-Value="model.Name" />
                <ValidationMessage For="() => model.Name" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Beskrivning</label>
                <InputTextArea class="form-control" @bind-Value="model.Description" />
                <ValidationMessage For="() => model.Description" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Lärare</label>
                <select class="form-select" @bind="model.TeacherId">
                    <option value="">-- Välj lärare (valfritt) --</option>

                    @foreach (var t in teachers)
                    {
                        <option value="@t.Id">@t.FullName</option>
                    }
                </select>
                <ValidationMessage For="() => model.TeacherId" />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Startdatum</label>
                    <InputDate class="form-control" @bind-Value="model.StartDate" ParsingErrorMessage="Startdatum måste vara ett giltigt datum." />
                    <ValidationMessage For="() => model.StartDate" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Slutdatum</label>
                    <InputDate class="form-control" @bind-Value="model.EndDate" ParsingErrorMessage="Slutdatum måste vara ett giltigt datum." />
                    <ValidationMessage For="() => model.EndDate" />
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 mb-0">Moduler (valfritt)</h2>
                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddModule"><i class="bi bi-plus-circle me-2"></i>Lägg till modul</button>
            </div>

            @if (moduleItems.Count == 0)
            {
                <p class="text-muted">Inga moduler tillagda.</p>
            }

            @for (int i = 0; i < moduleItems.Count; i++)
            {
                var item = moduleItems[i];
                var moduleIndex = i;

                <CreateCourseModuleEditor @key="item.RowId"
                                          @ref="item.EditorRef"
                                          Module="item.Module"
                                          ModuleIndex="moduleIndex"
                                          OnRemove="() => RemoveModule(item.RowId)" />
            }

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                    @(isSubmitting ? "Sparar..." : "Skapa kurs")
                </button>

                @if (IsModal) // Ska bara visas om komponenten visas i modalt fönster
                {
                    <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">
                        Avbryt
                    </button>
                }
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public EventCallback<CourseDto> OnCreated { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public bool IsModal { get; set; } = false;

    private CourseCreateDto model = new()
    {
        StartDate = DateTime.Today,
        EndDate = DateTime.Today.AddMonths(6)
    };

    private EditContext? courseEditContext;
    private string? errorMessage;
    private bool isSubmitting;

    private List<CreateCourseModuleItem> moduleItems = new();

    private List<TeacherItem> teachers = new();

    protected override async Task OnInitializedAsync()
    {
        courseEditContext = new EditContext(model);

        teachers = await ApiService.GetAsync<List<TeacherItem>>("api/course/teachers")
                   ?? new List<TeacherItem>();
    }

    private void AddModule()
    {
        var module = new ModuleCreateDto
        {
            StartDate = model.StartDate,
            EndDate = model.EndDate
        };

        model.Modules.Add(module);

        moduleItems.Add(new CreateCourseModuleItem
        {
            Module = module
        });
    }

    private void RemoveModule(Guid rowId)
    {
        var item = moduleItems.FirstOrDefault(x => x.RowId == rowId);

        if (item is null)
            return;

        model.Modules.Remove(item.Module);
        moduleItems.Remove(item);
    }

    private async Task HandleSubmit(EditContext _)
    {
        if (isSubmitting)
            return;

        errorMessage = null;

        bool courseIsValid = courseEditContext?.Validate() ?? false;

        bool modulesAreValid = true;

        foreach (var item in moduleItems)
        {
            if (item.EditorRef is not null)
            {
                if (!item.EditorRef.Validate())
                    modulesAreValid = false;
            }
        }

        if (!courseIsValid || !modulesAreValid)
        {
            errorMessage = "Formuläret innehåller fel.";
            return;
        }

        isSubmitting = true;

        try
        {
            var result = await ApiService.PostAsync<CourseCreateDto, CourseDto>("api/course", model);

            if (result is null)
            {
                errorMessage = "Kunde inte skapa kurs.";
                return;
            }

            await OnCreated.InvokeAsync(result);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync();
    }

    public class CreateCourseModuleItem
    {
        public Guid RowId { get; set; } = Guid.NewGuid();
        public ModuleCreateDto Module { get; set; } = new();
        public CreateCourseModuleEditor? EditorRef { get; set; }
    }

    public class TeacherItem
    {
        public string? Id { get; set; }
        public string FullName { get; set; } = "";
    }
}
