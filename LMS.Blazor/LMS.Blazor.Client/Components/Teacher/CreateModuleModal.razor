@code {
    // [Parameter] public bool Show { get; set; }

    [Parameter, EditorRequired]
    public int CourseId { get; set; }

    [Parameter]
    public DateTime? CourseStartDate { get; set; }

    [Parameter]
    public DateTime? CourseEndDate { get; set; }

    [Parameter]
    public IEnumerable<ModuleDto>? ExistingModules { get; set; }

    [Parameter]
    public EventCallback OnCreated { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private ModuleCreateDto model = new();
    private string? errorMessage;
    private bool isSubmitting;

    protected override void OnParametersSet()
    {
        // if (Show)
        // {
            ResetForm();
        // }
    }    

    private async Task HandleValidSubmit()
    {
        errorMessage = null;
        isSubmitting = true;

        try
        {
            var result = await ApiService.PostAsync<ModuleCreateDto, ModuleDto>(
                $"api/courses/{CourseId}/modules",
                model);

            if (result is null)
            {
                errorMessage = "Modulen kunde inte skapas.";
                return;
            }

            ResetForm();

            if (OnCreated.HasDelegate)
                await OnCreated.InvokeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Fel vid skapande av modul: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task Close()
    {
        errorMessage = null;
        ResetForm();

        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();
    }

    private void ResetForm()
    {
        model = new ModuleCreateDto
        {
            StartDate = CourseStartDate ?? DateTime.Today,
            EndDate = CourseEndDate ?? DateTime.Today
        };
    }

    private List<(DateTime Start, DateTime End)> AvailableDateRanges => GetAvailableDateRanges();

    private List<(DateTime Start, DateTime End)> GetAvailableDateRanges()
    {
        var availableRanges = new List<(DateTime Start, DateTime End)>();

        if (!CourseStartDate.HasValue || !CourseEndDate.HasValue)
            return availableRanges;

        var courseStart = CourseStartDate.Value.Date;
        var courseEnd = CourseEndDate.Value.Date;

        var modules = (ExistingModules ?? Enumerable.Empty<ModuleDto>())
            .OrderBy(m => m.StartDate)
            .ToList();

        // Inga moduler alls => hela kursintervallet är ledigt
        if (!modules.Any())
        {
            availableRanges.Add((courseStart, courseEnd));
            return availableRanges;
        }

        var currentStart = courseStart;

        foreach (var module in modules)
        {
            var moduleStart = module.StartDate.Date;
            var moduleEnd = module.EndDate.Date;

            // Finns ett glapp före denna modul?
            if (currentStart < moduleStart)
            {
                availableRanges.Add((currentStart, moduleStart.AddDays(-1)));
            }

            // Nästa möjliga lediga datum börjar dagen efter modulens slut
            if (moduleEnd.AddDays(1) > currentStart)
            {
                currentStart = moduleEnd.AddDays(1);
            }
        }

        // Finns ledigt intervall efter sista modulen?
        if (currentStart <= courseEnd)
        {
            availableRanges.Add((currentStart, courseEnd));
        }

        // Filtrera bort ogiltiga intervall
        return availableRanges
            .Where(r => r.Start <= r.End)
            .ToList();
    }
}