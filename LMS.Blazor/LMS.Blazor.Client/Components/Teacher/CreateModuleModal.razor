@using LMS.Blazor.Client.Services
@using LMS.Shared.DTOs.Module
@using Microsoft.AspNetCore.Components.Forms
@inject IApiService ApiService

<div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Skapa ny modul</h5>
                <button type="button" class="btn-close" @onclick="Close"></button>
            </div>

            <EditForm Model="model" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />

                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-danger">@((MarkupString)errorMessage)</div>
                    }

                    @if (!HasAvailableDates)
                    {
                        <div class="alert alert-warning mt-2">
                            Lediga datum saknas i kursen! <br />
                            Ändra/ta bort befintliga moduler för att frigöra datum.
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">Modulnamn</label>
                            <InputText class="form-control" @bind-Value="model.Name" />
                            <ValidationMessage For="() => model.Name" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Beskrivning</label>
                            <InputTextArea class="form-control" @bind-Value="model.Description" />
                            <ValidationMessage For="() => model.Description" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Startdatum</label>
                                <InputDate class="form-control"
                                           @bind-Value="model.StartDate"
                                           ParsingErrorMessage="Startdatum måste vara ett giltigt datum." />
                                <ValidationMessage For="() => model.StartDate" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Slutdatum</label>
                                <InputDate class="form-control"
                                           @bind-Value="model.EndDate"
                                           ParsingErrorMessage="Slutdatum måste vara ett giltigt datum." />
                                <ValidationMessage For="() => model.EndDate" />
                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                                @(isSubmitting ? "Sparar..." : "Skapa modul")
                            </button>

                            <button type="button" class="btn btn-outline-secondary" @onclick="Close">
                                Avbryt
                            </button>
                        </div>
                    }
                </div>
            </EditForm>

        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public int CourseId { get; set; }

    [Parameter]
    public DateTime? CourseStartDate { get; set; }

    [Parameter]
    public DateTime? CourseEndDate { get; set; }

    [Parameter]
    public IEnumerable<ModuleDto>? ExistingModules { get; set; }

    [Parameter]
    public EventCallback OnCreated { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private ModuleCreateDto model = new();
    private string? errorMessage;
    private bool isSubmitting;

    protected override void OnParametersSet()
    {
        ResetForm();
    }

    private async Task HandleValidSubmit()
    {
        errorMessage = null;
        isSubmitting = true;

        try
        {
            if (!CourseStartDate.HasValue || !CourseEndDate.HasValue)
            {
                errorMessage = "Kursens datumintervall saknas.";
                return;
            }

            var courseStart = CourseStartDate.Value.Date;
            var courseEnd = CourseEndDate.Value.Date;
            var moduleStart = model.StartDate.Date;
            var moduleEnd = model.EndDate.Date;

            // Start efter slut
            if (moduleStart > moduleEnd)
            {
                errorMessage = "Startdatum kan inte ligga efter slutdatum.";
                return;
            }

            // Utanför kursintervall (smart uppdelat)
            var startBefore = moduleStart < courseStart;
            var endAfter = moduleEnd > courseEnd;

            if (startBefore && endAfter)
            {
                errorMessage = $"Start- och slutdatum kan inte ligga utanför kursens datumintervall {courseStart:yyyy-MM-dd} - {courseEnd:yyyy-MM-dd}.";
                return;
            }

            if (startBefore)
            {
                errorMessage = $"Startdatum kan inte ligga före kursens startdatum <br /> {courseStart:yyyy-MM-dd}.";
                return;
            }

            if (endAfter)
            {
                errorMessage = $"Slutdatum kan inte ligga efter kursens slutdatum <br />  {courseEnd:yyyy-MM-dd}.";
                return;
            }

            // Överlapp
            if (HasOverlap(moduleStart, moduleEnd))
            {
                errorMessage = "Modulen överlappar en annan modul i kursen.";
                return;
            }

            var result = await ApiService.PostAsync<ModuleCreateDto, ModuleDto>(
                $"api/courses/{CourseId}/modules",
                model);

            if (result is null)
            {
                errorMessage = "Modulen kunde inte skapas.";
                return;
            }

            ResetForm();

            if (OnCreated.HasDelegate)
                await OnCreated.InvokeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private bool HasOverlap(DateTime startDate, DateTime endDate)
    {
        var modules = ExistingModules ?? Enumerable.Empty<ModuleDto>();

        return modules.Any(m =>
            startDate <= m.EndDate.Date && endDate >= m.StartDate.Date);
    }

    private async Task Close()
    {
        errorMessage = null;
        ResetForm();

        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();
    }

    private void ResetForm()
    {
        var firstAvailableStart = GetFirstAvailableStartDate()
                                  ?? (CourseStartDate ?? DateTime.Today).Date;

        model = new ModuleCreateDto
        {
            StartDate = firstAvailableStart,
            EndDate = firstAvailableStart
        };

        errorMessage = null;
    }

    private bool HasAvailableDates => GetFirstAvailableStartDate().HasValue;

    private DateTime? GetFirstAvailableStartDate()
    {
        if (!CourseStartDate.HasValue || !CourseEndDate.HasValue)
            return null;

        var courseStart = CourseStartDate.Value.Date;
        var courseEnd = CourseEndDate.Value.Date;

        var modules = (ExistingModules ?? Enumerable.Empty<ModuleDto>())
            .OrderBy(m => m.StartDate.Date)
            .ToList();

        if (!modules.Any())
            return courseStart;

        var currentStart = courseStart;

        foreach (var module in modules)
        {
            var moduleStart = module.StartDate.Date;
            var moduleEnd = module.EndDate.Date;

            if (currentStart < moduleStart)
                return currentStart;

            if (moduleEnd.AddDays(1) > currentStart)
                currentStart = moduleEnd.AddDays(1);
        }

        if (currentStart <= courseEnd)
            return currentStart;

        return null;
    }
}