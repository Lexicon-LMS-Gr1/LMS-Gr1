@using LMS.Shared.DTOs.Course
@using Microsoft.AspNetCore.Components.Forms
@inject IApiService ApiService

@if (Show)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        <span class="bi bi-pencil-square me-2"></span>
                        Redigera kurs
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>

                <EditForm Model="FormModel" OnValidSubmit="Save">
                    <DataAnnotationsValidator />

                    <div class="modal-body">

                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div class="alert alert-danger py-2">
                                @ErrorMessage
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Namn</label>
                            <InputText class="form-control" @bind-Value="FormModel.Name" />
                            <ValidationMessage For="() => FormModel.Name" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Beskrivning</label>
                            <InputTextArea class="form-control" @bind-Value="FormModel.Description" rows="3" />
                            <ValidationMessage For="() => FormModel.Description" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Lärare</label>
                            <select class="form-select" @bind="FormModel.TeacherId">
                                <option value="">-- Ingen lärare --</option>

                                @foreach (var t in Teachers.OrderBy(t => t.FullName))
                                {
                                    <option value="@t.Id">@t.FullName</option>
                                }
                            </select>
                        </div>


                        <div class="mb-3">
                            <label class="form-label fw-semibold">Startdatum</label>
                            <InputDate class="form-control" @bind-Value="FormModel.StartDate" ParsingErrorMessage="Startdatum måste vara ett giltigt datum." />
                            <ValidationMessage For="() => FormModel.StartDate" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Slutdatum</label>
                            <InputDate class="form-control" @bind-Value="FormModel.EndDate" ParsingErrorMessage="Slutdatum måste vara ett giltigt datum." />
                            <ValidationMessage For="() => FormModel.EndDate" class="text-danger small" />
                        </div>

                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="Close" disabled="@IsSaving">Avbryt</button>
                        <button type="submit" class="btn btn-primary d-flex align-items-center gap-2" disabled="@IsSaving">
                            @if (IsSaving)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            <span>Spara ändringar</span>
                        </button>
                    </div>

                </EditForm>

            </div>
        </div>
    </div>
}

@code {
    private List<TeacherItem> Teachers = new();
    [Parameter] public bool Show { get; set; }
    [Parameter] public CourseUpdateDto FormModel { get; set; } = new();
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<CourseUpdateDto> OnSave { get; set; }

    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Teachers = await ApiService.GetAsync<List<TeacherItem>>("api/course/teachers")
                       ?? new List<TeacherItem>();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading teachers: " + ex.Message);
            Teachers = new List<TeacherItem>();
        }
    }


    private async Task Save()
    {
        await OnSave.InvokeAsync(FormModel);
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    public class TeacherItem
    {
        public string? Id { get; set; }
        public string FullName { get; set; } = "";
    }
}
