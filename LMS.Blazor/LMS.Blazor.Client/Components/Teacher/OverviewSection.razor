@using LMS.Shared.DTOs.TeacherDashboard

@code {
    [Parameter] public TeacherDashboardDto Dashboard { get; set; } = null!;
}

<div class="row g-4">

    <!-- Aktiva kurser -->
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">
                    <i class="bi bi-lightning-charge-fill text-warning me-2"></i>
                    Aktiva kurser
                </h5>
            </div>

            <div class="list-group list-group-flush">
                @foreach (var c in Dashboard.ActiveCourses)
                {
                    <div class="list-group-item">
                        <div class="fw-semibold">@c.Name</div>

                        <div class="text-muted small mt-1 d-flex align-items-center gap-3">
                            <span>
                                <i class="bi bi-people-fill me-1"></i>
                                @c.StudentCount elever
                            </span>

                            <span>
                                <i class="bi bi-layers-fill me-1"></i>
                                @c.ModuleCount moduler
                            </span>

                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Senaste aktivitet -->
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="card-title mb-0">
                    <i class="bi bi-clock-history text-primary me-2"></i>
                    Senaste aktivitet
                </h5>
            </div>

            <div class="list-group list-group-flush">
                @foreach (var a in Dashboard.RecentActivities)
                {
                    <div class="list-group-item">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge @GetBadgeColor(a.Type)">
                                @a.Type
                            </span>
                            <span class="fw-semibold">@a.Description</span>
                        </div>

                        <div class="text-muted small">
                            <i class="bi bi-clock me-1"></i>
                            @a.Timestamp.ToString("yyyy-MM-dd HH:mm")
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Kommande aktiviteter -->
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="card-title mb-0">
                    <i class="bi bi-calendar-event-fill text-info me-2"></i>
                    Kommande aktiviteter
                </h5>
            </div>

            <div class="list-group list-group-flush">
                @foreach (var u in Dashboard.UpcomingActivities)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge @GetBadgeColor(u.Type) me-2">@u.Type</span>

                            <strong>@u.Name</strong><br />
                            <span class="text-muted small">@u.CourseName</span>
                        </div>

                        <div class="text-muted small text-end">
                            <i class="bi bi-clock-history me-1"></i>
                            @u.StartTime.ToString("yyyy-MM-dd HH:mm")
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

</div>

@code {
    private string GetBadgeColor(string type)
    {
        return type switch
        {
            "Lecture" => "bg-primary",
            "Workshop" => "bg-warning text-dark",
            "Assignment" => "bg-info text-dark",
            "Exam" => "bg-danger",
            "Seminar" => "bg-success",
            _ => "bg-secondary"
        };
    }
}
