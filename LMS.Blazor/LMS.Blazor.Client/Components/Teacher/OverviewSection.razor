@using LMS.Shared.DTOs.Course
@using LMS.Shared.DTOs.TeacherDashboard

@code {
    [Parameter] public TeacherDashboardDto Dashboard { get; set; } = null!;

    [Parameter] public EventCallback<int> OnOpenCourse { get; set; }
    [Parameter] public EventCallback<CourseListDto> OnEditCourse { get; set; }
    [Parameter] public EventCallback<int> OnDeleteCourse { get; set; }
}

<div class="row g-4">

    <!-- Aktiva kurser -->
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="card-title mb-0">Aktiva kurser</h5>
            </div>

            <div class="list-group list-group-flush">
                @foreach (var c in Dashboard.ActiveCourses)
                {
                    var course = new CourseListDto
                    {
                        Id = c.Id,
                        Name = c.Name,
                        Description = c.Description,
                        StartDate = c.StartDate,
                        EndDate = c.EndDate,
                        StudentCount = c.StudentCount,
                        ModuleCount = c.ModuleCount
                    };

                    <div class="list-group-item d-flex justify-content-between align-items-center">

                        <!-- Left side -->
                        <div style="cursor:pointer;" @onclick="() => OnOpenCourse.InvokeAsync(course.Id)">
                            <div class="fw-semibold">@course.Name</div>

                            <div class="text-muted small mt-1 d-flex align-items-center gap-3">
                                <span><i class="bi bi-people-fill me-1"></i>@course.StudentCount elever</span>
                                <span><i class="bi bi-layers-fill me-1"></i>@course.ModuleCount moduler</span>
                            </div>
                        </div>

                        <!-- Right side -->
                        <div class="d-flex align-items-center gap-2">

                            <button class="btn btn-sm btn-outline-secondary"
                                    @onclick="() => OnOpenCourse.InvokeAsync(course.Id)">
                                <i class="bi bi-eye"></i>
                            </button>

                            <button class="btn btn-sm btn-outline-primary"
                                    @onclick="() => OnEditCourse.InvokeAsync(course)">
                                <i class="bi bi-pencil-fill"></i>
                            </button>

                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => OnDeleteCourse.InvokeAsync(course.Id)">
                                <i class="bi bi-trash"></i>
                            </button>

                        </div>
                    </div>
                }
            </div>
        </div>
    </div>


    <!-- Senaste aktivitet -->
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="card-title mb-0">
                    <i class="text-primary me-2"></i>
                    Senaste aktivitet
                </h5>
            </div>

            <div class="list-group list-group-flush">
                @foreach (var a in Dashboard.RecentActivities)
                {
                    <div class="list-group-item">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge @GetBadgeColor(a.Type)">
                                @a.Type
                            </span>
                            <span class="fw-semibold">@a.Description</span>
                        </div>

                        <div class="text-muted small">
                            <i class="bi bi-clock me-1"></i>
                            @a.Timestamp.ToString("yyyy-MM-dd HH:mm")
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Kommande aktiviteter -->
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="card-title mb-0">
                    <i class="text-info me-2"></i>
                    Kommande aktiviteter
                </h5>
            </div>

            <div class="list-group list-group-flush">
                @foreach (var u in Dashboard.UpcomingActivities)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge @GetBadgeColor(u.Type) me-2">@u.Type</span>

                            <strong>@u.Name</strong><br />
                            <span class="text-muted small">@u.CourseName</span>
                        </div>

                        <div class="text-muted small text-end">
                            <i class="bi bi-clock-history me-1"></i>
                            @u.StartTime.ToString("yyyy-MM-dd HH:mm")
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

</div>

@code {
    private string GetBadgeColor(string type)
    {
        return type switch
        {
            "Lecture" => "bg-primary",
            "Workshop" => "bg-warning text-dark",
            "Assignment" => "bg-info text-dark",
            "Exam" => "bg-danger",
            "Seminar" => "bg-success",
            _ => "bg-secondary"
        };
    }
}
