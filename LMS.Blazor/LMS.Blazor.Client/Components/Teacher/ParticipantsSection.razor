@using LMS.Shared.DTOs.TeacherDashboard

<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <div class="row align-items-center g-2">

            <!-- SEARCH -->
            <div class="col-12 col-md">
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <span class="bi bi-search"></span>
                    </span>
                    <input type="text"
                           class="form-control"
                           placeholder="Sök student..."
                           @bind="searchQuery"
                           @bind:event="oninput" />
                </div>
            </div>

            <!-- FILTER BY COURSE -->
            <div class="col-auto">
                <select class="form-select" @bind="courseFilter">
                    <option value="">Alla kurser</option>
                    @foreach (var c in Students.Select(s => s.CourseName).Distinct())
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>

        </div>
    </div>

    <div class="card-body p-0">

        <!-- DESKTOP TABLE -->
        <div class="d-none d-md-block table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Namn</th>
                        <th>E‑post</th>
                        <th>Kurs</th>
                        <th class="text-end pe-4">Åtgärder</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var s in FilteredStudents)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@s.FullName</td>
                            <td>@s.Email</td>
                            <td>@s.CourseName</td>
                         

                            <td class="text-end pe-4">
                                <button class="btn btn-sm btn-outline-primary me-2"
                                        @onclick="() => OnEdit.InvokeAsync(s)">
                                    <span class="bi bi-pencil-fill me-1"></span> Redigera
                                </button>

                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => OnDelete.InvokeAsync(s)">
                                    <span class="bi bi-trash-fill me-1"></span> Ta bort
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- MOBILE CARDS -->
        <div class="d-md-none">
            @foreach (var s in FilteredStudents)
            {
                <div class="border-bottom p-3">

                    <div class="fw-semibold">@s.FullName</div>
                    <div class="text-muted small">@s.Email</div>

                    <div class="mt-2 small">
                        <span class="fw-semibold">Kurs:</span> @s.CourseName
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button class="btn btn-sm btn-outline-primary px-3"
                                @onclick="() => OnEdit.InvokeAsync(s)">
                            <span class="bi bi-pencil-fill me-1"></span> Redigera
                        </button>

                        <button class="btn btn-sm btn-outline-danger px-3"
                                @onclick="() => OnDelete.InvokeAsync(s)">
                            <span class="bi bi-trash-fill me-1"></span> Ta bort
                        </button>
                    </div>

                </div>
            }
        </div>

    </div>

    <div class="card-footer bg-white text-muted py-2 px-4">
        Visar @FilteredStudents.Count() av @Students.Count() deltagare
    </div>
</div>

@code {
    [Parameter] public List<StudentListDto> Students { get; set; } = new();
    [Parameter] public EventCallback<StudentListDto> OnEdit { get; set; }
    [Parameter] public EventCallback<StudentListDto> OnDelete { get; set; }

    private string searchQuery = string.Empty;
    private string courseFilter = string.Empty;

    private IEnumerable<StudentListDto> FilteredStudents =>
        Students
            .Where(s =>
                (string.IsNullOrWhiteSpace(searchQuery) ||
                 s.FullName.ToLower().Contains(searchQuery.ToLower()) ||
                 s.Email.ToLower().Contains(searchQuery.ToLower()))
                &&
                (string.IsNullOrWhiteSpace(courseFilter) ||
                 s.CourseName == courseFilter)
            )
            .OrderBy(s => s.FullName);
}
