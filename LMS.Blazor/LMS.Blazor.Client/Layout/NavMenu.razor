@implements IDisposable
@inject NavigationManager NavigationManager

<div class="sidebar-wrapper">
    <div class="sidebar-logo">
        <svg xmlns="http://www.w3.org/2000/svg"
             width="26" height="26" viewBox="0 0 24 24"
             fill="none" stroke="#3b82f6" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true">
            <path d="M12 7v14"></path>
            <path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path>
        </svg>
        <span class="brand-text">Lexicon LMS</span>
    </div>

    <input type="checkbox" title="Navigation menu" class="nav-toggler" />

    <div class="sidebar-scroll">
        <AuthorizeView>
            <Authorized Context="authState">
                
                <div class="section-label">HANTERING</div>


                <nav>
                    @{
                        var items = authState.User.IsInRole("Teacher")
                            ? TeacherMenuItems
                            : StudentMenuItems;
                    }
                    @foreach (var item in items)
                    {
                        <div class="nav-entry">
                            <NavLink class="nav-btn" href="@item.Href" Match="@item.Match">
                                <i class="@item.Icon nav-btn-icon"></i>
                                <span class="nav-btn-text">@item.Text</span>
                            </NavLink>
                        </div>
                    }
                </nav>

               
                <div class="profile-area">
                    <div class="profile-card">
                        <div class="profile-avatar">
                            @{
                                var uName = authState.User.Identity?.Name ?? "?";
                                var uInitials = uName.Length >= 2
                                    ? uName.Substring(0, 2).ToUpper()
                                    : uName.ToUpper();
                            }
                            @uInitials
                        </div>
                        <div class="profile-info">
                            <div class="profile-name">@uName</div>
                            <div class="profile-role">
                                @(authState.User.IsInRole("Teacher") ? "Lärare" : "Elev")
                            </div>
                        </div>
                    </div>
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="btn-logout">
                            <i class="bi bi-box-arrow-left"></i>
                            Logga ut
                        </button>
                    </form>
                </div>
            </Authorized>

            <NotAuthorized>
                <nav class="mt-3">
                    <div class="nav-entry">
                        <NavLink class="nav-btn" href="Account/Login">
                            <i class="bi bi-box-arrow-in-right nav-btn-icon"></i>
                            <span class="nav-btn-text">Logga in</span>
                        </NavLink>
                    </div>
                </nav>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    private string? currentUrl;

    private List<NavMenuItemModel> StudentMenuItems => new()
    {
        new("bi bi-house", "Dashboard", "dashboard", NavLinkMatch.All),
        new("bi bi-book", "Min kurs", "student/course"),
        new("bi bi-file-earmark-text", "Inlämningar", "/assignments"),
        new("bi bi-people", "Kursdeltagare", "/participants")
    };

    private List<NavMenuItemModel> TeacherMenuItems => new()
    {
        new("bi bi-house", "Dashboard", "teacher/dashboard", NavLinkMatch.All),
        new("bi bi-book", "Kurser", "teacher/courses", NavLinkMatch.All),
        new("bi bi-plus-circle", "Skapa ny kurs", "teacher/courses/create"),
        new("bi bi-plus-circle", "Skapa ny aktivitet", "/teacher/activities/create"),
        new("bi bi-people", "Användare", "teacher/users")
    };

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
