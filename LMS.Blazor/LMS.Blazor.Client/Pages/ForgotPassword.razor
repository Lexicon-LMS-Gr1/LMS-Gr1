@page "/forgot"
@using System.ComponentModel.DataAnnotations
@using LMS.Shared.DTOs.AuthDtos
@inject IApiService Api
@attribute [AllowAnonymous]

<h3>Glömt lösenord</h3>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info">@message</div>
}

<EditForm Model="model" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label">E‑post</label>
        <InputText class="form-control" @bind-Value="model.Email" />
        <ValidationMessage For="@(() => model.Email)" />
    </div>

    <button class="btn btn-primary" type="submit">Skicka återställningslänk</button>
</EditForm>

@code {
    private ForgotPasswordModel model = new();
    private string? message;

    private async Task SubmitAsync()
    {
        var dto = new RequestPasswordResetDto
        {
            Email = model.Email
        };

        await Api.PostAsync<RequestPasswordResetDto, object>("auth/request-password-reset", dto);

        message = "Om ett konto med den e‑postadressen finns har en länk skickats.";
    }

    public class ForgotPasswordModel
    {
        [Required, EmailAddress]
        public string Email { get; set; } = string.Empty;
    }
}
