@page "/participants"
@using LMS.Shared.DTOs.Course
@inject IApiService Api
@attribute [Authorize(Roles = "Student")]

<h2 class="mb-3">Deltagare</h2>

@if (isLoading)
{
    <div class="alert alert-info">Laddar deltagare...</div>
}
else if (participants is null || participants.Count == 0)
{
    <div class="alert alert-warning">Inga deltagare hittades.</div>
}
else
{
    <ul class="list-group mt-3">
        @foreach (var p in participants)
        {
            <li class="list-group-item d-flex justify-content-between">
                <span>@p.FullName</span>
                <span class="text-muted">@p.Email</span>
            </li>
        }
    </ul>
}

@code {
    private List<ParticipantDto>? participants;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;

            participants = await Api.GetAsync<List<ParticipantDto>>(
                "api/user/me/course/participants"
            );
        }
        finally
        {
            isLoading = false;
        }
    }
}