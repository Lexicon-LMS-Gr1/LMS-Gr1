@page "/participants"
@using LMS.Shared.DTOs.Course
@inject IApiService Api
@attribute [Authorize(Roles = "Student")]

<PageTitle>Deltagare — Lexicon LMS</PageTitle>

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="mb-2">
        <h2 class="mb-1">
            <span class="bi bi-people-fill me-2"></span>Deltagare i min kurs
        </h2>
        <p class="text-muted mb-0">Lista över alla elever i din kurs</p>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">
            <span class="bi bi-exclamation-triangle me-2"></span>
            @errorMessage
        </div>
    }



    <!-- SEARCH BELOW HEADER, RIGHT ALIGNED -->
    <div class="d-flex justify-content-end mb-4">
        <div class="d-flex gap-2" style="width: 400px;">
            <input type="text"
                   class="form-control"
                   placeholder="Sök deltagare..."
                   @bind="searchTerm" />

            <button class="btn btn-primary" @onclick="ApplySearch">
                Sök
            </button>

            <button class="btn btn-outline-secondary" @onclick="ResetSearch">
                Rensa
            </button>
        </div>
    </div>

    <!-- LOADING -->
    @if (isLoading)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Laddar...</span>
            </div>
        </div>
    }
    else if (participants == null || participants.Count == 0)
    {
        <div class="alert alert-info">
            <span class="bi bi-info-circle me-2"></span>
            Inga deltagare hittades.
        </div>
    }
    else
    {
        <!-- TABLE FULL WIDTH -->
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0">
                    <span class="bi bi-list-ul me-2"></span>Deltagarlista
                </h5>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Namn</th>
                                <th>E‑post</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in FilteredParticipants)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center"
                                                 style="width: 36px; height: 36px; font-size: 0.85rem; font-weight: 600;">
                                                @p.FullName[0]
                                            </div>
                                            <div>
                                                <div class="fw-semibold">@p.FullName</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@p.Email</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer bg-white text-muted py-2 px-4">
                Visar @FilteredParticipants.Count() deltagare
            </div>
        </div>
    }
</div>

@code {
    private List<ParticipantDto>? participants;
    private bool isLoading = true;
    private string searchTerm = "";
    private string appliedSearch = "";
    private string? errorMessage;


    private IEnumerable<ParticipantDto> FilteredParticipants =>
        string.IsNullOrWhiteSpace(appliedSearch)
            ? participants!
            : participants!.Where(p =>
                p.FullName.Contains(appliedSearch, StringComparison.OrdinalIgnoreCase) ||
                p.Email.Contains(appliedSearch, StringComparison.OrdinalIgnoreCase));

    private void ApplySearch()
    {
        appliedSearch = searchTerm;
    }

    private void ResetSearch()
    {
        searchTerm = "";
        appliedSearch = "";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            participants = (await Api.GetAsync<List<ParticipantDto>>(
                "api/user/me/course/participants"
            ))?
            .OrderBy(p => p.LastName)
            .ThenBy(p => p.FirstName)
            .ThenBy(p => p.Id)
            .ToList();
        }
        catch (Exception ex)
        {
            errorMessage = "Kunde inte ladda deltagarlistan.";
            Console.Error.WriteLine($"Fel vid laddning av kursdeltagare: {ex.Message}");
            participants = new List<ParticipantDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

}