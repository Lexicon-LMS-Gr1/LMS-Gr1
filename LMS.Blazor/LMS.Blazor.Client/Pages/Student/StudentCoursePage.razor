@page "/student/course"
@using LMS.Shared.DTOs.Course
@using LMS.Blazor.Client.Components.CourseOverview
@attribute [Authorize(Roles = "Student")]

@inject IApiService Api

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">
        <span class="bi bi-exclamation-triangle me-2"></span>
        @errorMessage
    </div>
}

@if (course is null)
{
    <div class="alert alert-info">Laddar kurs...</div>
}
else
{
    <CourseOverviewView Course="course" />
}

@code {
    private CourseDto? course;
    private bool isLoading = true;
    private string? errorMessage;


    protected override async Task OnInitializedAsync()
    {
        try
        {
            course = await Api.GetAsync<CourseDto>("api/user/me/course");
        }
        catch (Exception ex)
        {
            errorMessage = "Kunde inte ladda kursen.";
            Console.Error.WriteLine($"Fel vid laddning av kursen: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

}