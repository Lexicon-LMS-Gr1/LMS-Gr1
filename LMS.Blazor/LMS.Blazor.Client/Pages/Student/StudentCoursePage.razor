@page "/student/course"
@using LMS.Shared.DTOs.Course
@using LMS.Blazor.Client.Components.CourseOverview
@attribute [Authorize(Roles = "Student")]

@inject IApiService Api

@if (course is null)
{
    <div class="alert alert-info">Laddar kurs...</div>
}
else
{
    <CourseOverviewView Course="course" />
}

@code {
    private CourseDto? course;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            course = await Api.GetAsync<CourseDto>("api/user/me/course");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Fel vid laddning av kursen: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}