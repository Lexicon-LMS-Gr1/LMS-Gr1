@page "/teacher/courses/{Id:int}"
@using LMS.Blazor.Client.Components.Teacher
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "Teacher")]

<CourseDetailsSection CourseId="Id"
               OnBack="GoBack" />


@code {
    [Parameter] public int Id { get; set; }

    private void GoBack() => NavigationManager.NavigateTo("/teacher/courses");
}

