@page "/teacher/courses/{courseId:int}"
@using LMS.Shared.DTOs.Course
@inject IApiService ApiService
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Teacher")]

<h3>CourseDetails</h3>

@if (course == null)
{
    <p>Laddar...</p>
}
else
{
    <h3>@course.Name</h3>
    <p>@course.Description</p>

    <h4>Moduler</h4>
    <ul>
        @foreach (var module in course.Modules)
        {
            <li>@module.Name</li>
            <button @onclick="() => GoToActivities(module.Id)">Aktiviteter</button>
        }
    </ul>
}

@code {
    [Parameter]
    public int courseId { get; set; }
    private CourseDto? course;

    protected override async Task OnInitializedAsync()
    {
        course = await ApiService.GetAsync<CourseDto>($"api/course/{courseId}");
    }
    private void GoToActivities(int moduleId)
    {
        Navigation.NavigateTo($"/teacher/modules/{moduleId}/activities");
    }
}