@page "/teacher/courses/{courseId:int}"
@using LMS.Shared.DTOs.Course
@using LMS.Shared.DTOs.Module
@inject IApiService ApiService
@inject NavigationManager Navigation

<h3>CourseDetails</h3>

@if (course == null)
{
    <p>Laddar...</p>
}
else
{
    <h3>@course.Name</h3>
    <p>@course.Description</p>

    <h4>Moduler</h4>
    <ul class="list-group">
        @foreach (var module in course.Modules)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>@module.Name</span>

                <button class="btn btn-sm btn-outline-primary"
                        @onclick="() => OpenEditModuleModal(module)">
                    <span class="bi bi-pencil-fill me-1"></span> Redigera
                </button>
            </li>
        }
    </ul>
}

<!-- EDIT MODULE MODAL -->
@if (showEditModuleModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        <span class="bi bi-pencil-square me-2"></span>
                        Redigera modul
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseEditModuleModal"></button>
                </div>

                <EditForm EditContext="moduleEditContext" OnValidSubmit="HandleModuleUpdate">
                    <DataAnnotationsValidator />

                    <div class="modal-body">

                        @if (!string.IsNullOrEmpty(moduleFormError))
                        {
                            <div class="alert alert-danger py-2">
                                <span class="bi bi-exclamation-triangle me-1"></span> @moduleFormError
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Namn</label>
                            <InputText class="form-control" @bind-Value="moduleFormModel.Name" />
                            <ValidationMessage For="() => moduleFormModel.Name" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Beskrivning</label>
                            <InputTextArea class="form-control" @bind-Value="moduleFormModel.Description" rows="3" />
                            <ValidationMessage For="() => moduleFormModel.Description" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Startdatum</label>
                            <InputDate class="form-control" @bind-Value="moduleFormModel.StartDate" />
                            <ValidationMessage For="() => moduleFormModel.StartDate" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Slutdatum</label>
                            <InputDate class="form-control" @bind-Value="moduleFormModel.EndDate" />
                            <ValidationMessage For="() => moduleFormModel.EndDate" class="text-danger small" />
                        </div>

                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseEditModuleModal" disabled="@isSavingModule">Avbryt</button>
                        <button type="submit" class="btn btn-primary d-flex align-items-center gap-2" disabled="@isSavingModule">
                            @if (isSavingModule)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            <span>Spara ändringar</span>
                        </button>
                    </div>

                </EditForm>

            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int courseId { get; set; }

    private CourseDto? course;

    // MODULE EDIT MODAL STATE
    private bool showEditModuleModal;
    private bool isSavingModule;
    private string? moduleFormError;
    private EditContext moduleEditContext;

    private ModuleUpdateDto moduleFormModel = new();

    protected override async Task OnInitializedAsync()
    {
        moduleEditContext = new EditContext(moduleFormModel);
        await LoadCourse();
    }

    private async Task LoadCourse()
    {
        course = await ApiService.GetAsync<CourseDto>($"api/course/{courseId}");
    }

    private void OpenEditModuleModal(ModuleDto module)
    {
        moduleFormModel = new ModuleUpdateDto
        {
            Id = module.Id,
            Name = module.Name,
            Description = module.Description,
            StartDate = module.StartDate,
            EndDate = module.EndDate,
            CourseId = module.CourseId
        };

        moduleEditContext = new EditContext(moduleFormModel);

        moduleFormError = null;
        showEditModuleModal = true;
    }


    private void CloseEditModuleModal()
    {
        showEditModuleModal = false;
        moduleFormError = null;
    }

    private async Task HandleModuleUpdate()
    {
        isSavingModule = true;
        moduleFormError = null;

        try
        {
            var result = await ApiService.PutAsync<ModuleUpdateDto, ModuleDto>(
                $"api/module/{moduleFormModel.Id}", moduleFormModel);

            if (result != null)
            {
                showEditModuleModal = false;
                await LoadCourse();
            }
            else
            {
                moduleFormError = "Kunde inte uppdatera modulen.";
            }
        }
        catch (Exception ex)
        {
            moduleFormError = ex.Message;
        }
        finally
        {
            isSavingModule = false;
        }
    }
}
