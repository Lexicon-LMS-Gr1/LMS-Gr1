@page "/teacher/submissions"
@using LMS.Blazor.Client.Components.Teacher
@using LMS.Shared.DTOs.Submission
@inject IApiService ApiService
@attribute [Authorize(Roles = "Teacher")]

<div class="card shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            <i class="bi bi-inboxes text-primary me-2"></i>
            Alla inlämningar
        </h5>

        <div class="d-flex align-items-center">
            <select class="form-select me-2"
                    style="width: 220px"
                    @onchange="OnCourseFilterChanged">
                <option value="">Alla kurser</option>

                @foreach (var c in courseNames)
                {
                    <option value="@c">@c</option>
                }
            </select>
        </div>
    </div>

    <div class="card-body">
        @if (isLoading)
        {
            <p>Laddar...</p>
        } else if (items == null || !items.Any())
        {
            <div class="alert alert-info mb-0">Inga inlämningar hittades.</div>
        } else
        {
            <div class="mb-4">
                <h6 class="fw-bold text-danger mb-3">
                    Väntar på feedback
                </h6>

                @if (!submissionsWithoutFeedback.Any())
                {
                    <div class="alert alert-light border">Alla inlämningar har feedback.</div>
                } else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 table-lg">
                                <colgroup>
                                    <col style="width: 20%">
                                    <col style="width: 15%">
                                    <col style="width: 15%">
                                    <col style="width: 20%">
                                    <col style="width: 15%">
                                    <col style="width: 10%">
                                    <col style="width: 5%">
                                </colgroup>

                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Elev</th>
                                    <th>Kurs</th>
                                    <th>Modul</th>
                                    <th>Aktivitet</th>
                                    <th>Inlämnad</th>
                                    <th>Fil</th>
                                    <th class="text-end pe-4">Feedback</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in submissionsWithoutFeedback)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <strong>@s.StudentName</strong><br />
                                            <span class="text-muted small">@s.StudentEmail</span>
                                        </td>

                                        <td>@s.CourseName</td>
                                        <td>@s.ModuleName</td>
                                        <td>@s.ActivityName</td>
                                        <td>@s.SubmittedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>
                                            <a class="btn btn-sm btn-outline-primary"
                                                   href="@($"/api/proxy/submissions/{s.SubmissionId}/download")"
                                                   target="_blank">
                                                Hämta fil
                                            </a>
                                        </td>
                                        <td class="text-end pe-4">
                                            <button class="btn btn-sm btn-outline-primary"
                                                    @onclick="() => OpenFeedbackModal(s)">
                                                <i class="bi bi-chat-dots fs-5"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div>
                <h6 class="fw-bold text-success mb-3">
                    Klara
                </h6>

                @if (!submissionsWithFeedback.Any())
                {
                    <div class="alert alert-light border">Inga inlämningar med feedback än.</div>
                } else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 table-lg">
                            <colgroup>
                                <col style="width: 20%">
                                <col style="width: 15%">
                                <col style="width: 15%">
                                <col style="width: 20%">
                                <col style="width: 15%">
                                <col style="width: 10%">
                                <col style="width: 5%">
                            </colgroup>
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Elev</th>
                                    <th>Kurs</th>
                                    <th>Modul</th>
                                    <th>Aktivitet</th>
                                    <th>Inlämnad</th>
                                    <th>Fil</th>
                                    <th class="text-end pe-4">Feedback</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in submissionsWithFeedback)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <strong>@s.StudentName</strong><br />
                                            <span class="text-muted small">@s.StudentEmail</span>
                                        </td>

                                        <td>@s.CourseName</td>
                                        <td>@s.ModuleName</td>
                                        <td>@s.ActivityName</td>
                                        <td>@s.SubmittedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>
                                            <a class="btn btn-sm btn-outline-primary"
                                                   href="@($"/api/proxy/submissions/{s.SubmissionId}/download")"
                                                   target="_blank">
                                                Hämta fil
                                            </a>
                                        </td>
                                        <td class="text-end pe-4">
                                            <button class="btn btn-sm btn-outline-primary"
                                                    @onclick="() => OpenFeedbackModal(s)">
                                                <i class="bi bi-chat-dots-fill fs-5"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </div>
</div>

<FeedbackModal Submission="selectedSubmission"
               Show="showFeedbackModal"
               OnClose="CloseFeedbackModal"
               OnSaved="OnFeedbackSaved" />

@code {
    private bool isLoading = true;
    private List<SubmissionListItemDto> items = new();

    private List<SubmissionListItemDto> submissionsWithoutFeedback = new();
    private List<SubmissionListItemDto> submissionsWithFeedback = new();

    private List<string> courseNames = new();
    private string selectedCourse = "";

    private SubmissionListItemDto? selectedSubmission;
    private bool showFeedbackModal = false;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        items = await ApiService.GetAsync<List<SubmissionListItemDto>>("api/submissions")
            ?? new List<SubmissionListItemDto>();

        courseNames = items
            .Select(i => i.CourseName)
            .Distinct()
            .OrderBy(n => n)
            .ToList();

        ApplyFilters();

        isLoading = false;
    }

    private void OnCourseFilterChanged(ChangeEventArgs e)
    {
        selectedCourse = e.Value?.ToString() ?? "";
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        IEnumerable<SubmissionListItemDto> query = items;

        if (!string.IsNullOrWhiteSpace(selectedCourse))
        {
            query = query.Where(i => i.CourseName == selectedCourse);
        }

        var filtered = query
            .OrderByDescending(i => i.SubmittedAt)
            .ToList();

        submissionsWithoutFeedback = filtered
            .Where(i => !i.HasFeedback)
            .ToList();

        submissionsWithFeedback = filtered
            .Where(i => i.HasFeedback)
            .ToList();
    }

    private void OpenFeedbackModal(SubmissionListItemDto submission)
    {
        selectedSubmission = submission;
        showFeedbackModal = true;
    }

    private void CloseFeedbackModal()
    {
        showFeedbackModal = false;
        selectedSubmission = null;
    }

    private void OnFeedbackSaved()
    {
        if (selectedSubmission != null)
        {
            selectedSubmission.HasFeedback = true;
            selectedSubmission.FeedbackGivenAt = DateTime.UtcNow;
        }

        ApplyFilters();

        showFeedbackModal = false;
        selectedSubmission = null;
    }
}