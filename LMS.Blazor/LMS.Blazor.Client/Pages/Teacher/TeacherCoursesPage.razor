@page "/teacher/courses"
@using LMS.Shared.DTOs.Course
@using LMS.Blazor.Client.Components.Teacher
@inject IApiService ApiService
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Teacher")]

<PageTitle>Kurshantering — Lexicon LMS</PageTitle>

<div class="container-fluid py-4">

    <div class="mb-4">
        <h2 class="mb-1">
            <span class="bi bi-journal-bookmark-fill me-2"></span>Kurser
        </h2>
        <p class="text-muted mb-2">Hantera alla kurser i systemet</p>

        <button class="btn btn-primary d-flex align-items-center"
                style="padding-top: .5rem; padding-bottom: .3rem;"
                @onclick="OpenCreateCourseModal">
            <span class="position-relative me-2" style="top: 0px;">
                <i class="bi bi-book fs-5"></i>
                <i class="bi bi-plus-circle position-absolute top-0 start-100 fs-6" style="transform: translate(-40%, -37%);"></i>
            </span>
            <span style="position: relative; top: 0px;">Skapa ny kurs</span>
        </button>
    </div>

    @if (courses is null)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Laddar...</span>
            </div>
        </div>
    }
    else if (!courses.Any())
    {
        <div class="alert alert-info">
            <span class="bi bi-info-circle me-2"></span>
            Inga kurser hittades.
        </div>
    }
    else
    {
        <CoursesSection Courses="courses"
                        OnView="GoToDetails"
                        OnEdit="OpenEditModal" />
    }
</div>

<!-- ======== SKAPA NY KURS I MODALT FÖNSTER ========= -->
@if (showCreateCourseModal)
{
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <span class="position-relative me-3">
                            <i class="bi bi-book fs-5"></i>
                            <i class="bi bi-plus-circle position-absolute top-0 start-100 translate-middle fs-6 bg-white rounded-circle"></i>
                        </span>
                        Skapa ny kurs
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseCreateCourse"></button>
                </div>

                <div class="modal-body">
                    <CreateCourseSection OnCreated="RefreshCourses"
                                         OnCancel="CloseCreateCourse" IsModal="true" />
                </div>

            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show"></div>
}

<!-- EDIT MODAL -->
<EditCourseModal Show="showEditModal"
                 FormModel="formModel"
                 OnSave="HandleUpdate"
                 OnClose="CloseEditModal"
                 IsSaving="isSaving"
                 ErrorMessage="@formError" />

@code {
    private List<CourseListDto>? courses;

    private bool showEditModal;
    private bool isSaving;
    private string? formError;
    private bool showCreateCourseModal = false;

    private CourseUpdateDto formModel = new();

    private async Task LoadCourses()
    {
        courses = (await ApiService.GetAsync<List<CourseListDto>>("api/course/list") ?? new())
            .OrderBy(c => c.StartDate).ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCourses();
    }

    private void OpenEditModal(CourseListDto course)
    {
        formModel = new CourseUpdateDto
        {
            Id = course.Id,
            Name = course.Name,
            Description = course.Description,
            TeacherId = course.TeacherId,
            StartDate = course.StartDate,
            EndDate = course.EndDate
        };

        formError = null;
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        formError = null;
    }

    private async Task HandleUpdate()
    {
        isSaving = true;
        formError = null;

        try
        {
            var result = await ApiService.PutAsync<CourseUpdateDto, CourseDto>(
                $"api/course/{formModel.Id}", formModel);

            if (result != null)
            {
                showEditModal = false;
                courses = (await ApiService.GetAsync<List<CourseListDto>>("api/course/list") ?? new())
                    .OrderBy(c => c.StartDate).ToList();
            }
            else
            {
                formError = "Kunde inte uppdatera kursen.";
            }
        }
        catch (Exception ex)
        {
            formError = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    // ----- SKAPA NY KURS I MODALT FÖNSTER -------

    private void OpenCreateCourseModal()
    {
        showCreateCourseModal = true;
    }

    private void GoToDetails(int courseId)
    {
        Navigation.NavigateTo($"/teacher/courses/{courseId}");
    }

    private void CloseCreateCourse()
    {
        showCreateCourseModal = false;
    }

    private async Task RefreshCourses(CourseDto course)
    {
        showCreateCourseModal = false;

        await LoadCourses();

        StateHasChanged();
    }
}
