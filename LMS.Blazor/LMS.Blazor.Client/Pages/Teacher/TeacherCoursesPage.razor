@page "/teacher/courses"
@using LMS.Shared.DTOs.Course
@inject IApiService ApiService
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Teacher")]

<PageTitle>Kurshantering — Lexicon LMS</PageTitle>

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-4">
        <div>
            <h2 class="mb-1">
                <span class="bi bi-journal-bookmark-fill me-2"></span>Kurser
            </h2>
            <p class="text-muted mb-0">Hantera alla kurser i systemet</p>
        </div>

    </div>

    <!-- LOADING -->
    @if (courses is null)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Laddar...</span>
            </div>
        </div>
    }
    else if (!courses.Any())
    {
        <div class="alert alert-info">
            <span class="bi bi-info-circle me-2"></span>
            Inga kurser hittades.
        </div>
    }
    else
    {
        <!-- CARD -->
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0">
                    <span class="bi bi-list-ul me-2"></span>Kurslista
                </h5>
            </div>

            <div class="card-body p-0">

                <!-- TABLE -->
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Namn</th>
                                <th>Beskrivning</th>
                                <th>Period</th>
                                <th>Elever</th>
                                <th>Moduler</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Åtgärder</th>

                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var course in courses)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">@course.Name</td>

                                    <td class="text-muted">
                                        @course.Description
                                    </td>

                                    <td>
                                        @course.StartDate.ToString("yyyy-MM-dd")
                                        –
                                        @course.EndDate.ToString("yyyy-MM-dd")
                                    </td>

                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @course.StudentCount
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge bg-secondary">
                                            @course.ModuleCount
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge @(course.Status == "Active" ? "bg-success" : "bg-warning text-dark")">
                                            @course.Status
                                        </span>
                                    </td>

                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-outline-primary me-2"
                                                @onclick="() => GoToDetails(course.Id)">
                                            <span class="bi bi-pencil-fill me-1"></span> Detaljer
                                        </button>
                                        <button class="btn btn-sm btn-outline-primary me-2"
                                                @onclick="() => OpenEditModal(course)">
                                            <span class="bi bi-pencil-fill me-1"></span> Redigera
                                        </button>
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    }
</div>

@* ==================== UPDATE MODAL ==================== *@
@if (showEditModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        <span class="bi bi-pencil-square me-2"></span>
                        Redigera kurs
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseEditModal"></button>
                </div>

                <EditForm Model="formModel" OnValidSubmit="HandleUpdate">
                    <DataAnnotationsValidator />

                    <div class="modal-body">

                        @if (!string.IsNullOrEmpty(formError))
                        {
                            <div class="alert alert-danger py-2">
                                <span class="bi bi-exclamation-triangle me-1"></span> @formError
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Namn</label>
                            <InputText class="form-control" @bind-Value="formModel.Name" />
                            <ValidationMessage For="() => formModel.Name" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Beskrivning</label>
                            <InputTextArea class="form-control" @bind-Value="formModel.Description" rows="3" />
                            <ValidationMessage For="() => formModel.Description" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Startdatum</label>
                            <InputDate class="form-control" @bind-Value="formModel.StartDate" />
                            <ValidationMessage For="() => formModel.StartDate" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Slutdatum</label>
                            <InputDate class="form-control" @bind-Value="formModel.EndDate" />
                            <ValidationMessage For="() => formModel.EndDate" class="text-danger small" />
                        </div>

                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseEditModal" disabled="@isSaving">Avbryt</button>
                        <button type="submit" class="btn btn-primary d-flex align-items-center gap-2" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            <span>Spara ändringar</span>
                        </button>
                    </div>

                </EditForm>

            </div>
        </div>
    </div>
}



@code {
    private List<CourseListDto>? courses;
    private bool showEditModal;
    private bool isSaving;
    private string? formError;

    private CourseUpdateDto formModel = new();


    protected override async Task OnInitializedAsync()
    {
        courses = await ApiService.GetAsync<List<CourseListDto>>("api/course/list");
    }

    private void OpenEditModal(CourseListDto course)
    {
        formModel = new CourseUpdateDto
        {
            Id = course.Id,
            Name = course.Name,
            Description = course.Description,
            StartDate = course.StartDate,
            EndDate = course.EndDate
        };

        formError = null;
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        formError = null;
    }

    private async Task HandleUpdate()
    {
        isSaving = true;
        formError = null;

        try
        {
            var result = await ApiService.PutAsync<CourseUpdateDto, CourseDto>(
                $"api/course/{formModel.Id}", formModel);

            if (result != null)
            {
                showEditModal = false;
                courses = await ApiService.GetAsync<List<CourseListDto>>("api/course/list");
            }
            else
            {
                formError = "Kunde inte uppdatera kursen.";
            }
        }
        catch (Exception ex)
        {
            formError = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void GoToDetails(int courseId)
    {
        Navigation.NavigateTo($"/teacher/courses/{courseId}");
    }


}
