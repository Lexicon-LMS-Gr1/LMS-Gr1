@page "/teacher/courses"
@using LMS.Shared.DTOs.Course
@inject IApiService ApiService
@attribute [Authorize(Roles = "Teacher")]

<PageTitle>Kurshantering — Lexicon LMS</PageTitle>

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-4">
        <div>
            <h2 class="mb-1">
                <span class="bi bi-journal-bookmark-fill me-2"></span>Kurser
            </h2>
            <p class="text-muted mb-0">Hantera alla kurser i systemet</p>
        </div>

    </div>

    <!-- LOADING -->
    @if (courses is null)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Laddar...</span>
            </div>
        </div>
    }
    else if (!courses.Any())
    {
        <div class="alert alert-info">
            <span class="bi bi-info-circle me-2"></span>
            Inga kurser hittades.
        </div>
    }
    else
    {
        <!-- CARD -->
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0">
                    <span class="bi bi-list-ul me-2"></span>Kurslista
                </h5>
            </div>

            <div class="card-body p-0">

                <!-- TABLE -->
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Namn</th>
                                <th>Beskrivning</th>
                                <th>Period</th>
                                <th>Elever</th>
                                <th>Moduler</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Aktiv</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var course in courses)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">@course.Name</td>

                                    <td class="text-muted">
                                        @course.Description
                                    </td>

                                    <td>
                                        @course.StartDate.ToString("yyyy-MM-dd")
                                        –
                                        @course.EndDate.ToString("yyyy-MM-dd")
                                    </td>

                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @course.StudentCount
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge bg-secondary">
                                            @course.ModuleCount
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge @(course.Status == "Active" ? "bg-success" : "bg-warning text-dark")">
                                            @course.Status
                                        </span>
                                    </td>

                                    <td class="text-end pe-4">
                                        @if (course.IsActive)
                                        {
                                            <span class="badge bg-success">Ja</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Nej</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    }
</div>



@code {
    private List<CourseListDto>? courses;

    protected override async Task OnInitializedAsync()
    {
        courses = await ApiService.GetAsync<List<CourseListDto>>("api/course/list");
    }
}
