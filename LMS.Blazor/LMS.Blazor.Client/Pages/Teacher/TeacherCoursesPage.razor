@page "/teacher/courses"
@using LMS.Shared.DTOs.Course
@using LMS.Blazor.Client.Components.Teacher
@inject IApiService ApiService
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Teacher")]

<PageTitle>Kurshantering — Lexicon LMS</PageTitle>

<div class="container-fluid py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-4">
        <div>
            <h2 class="mb-1">
                <span class="bi bi-journal-bookmark-fill me-2"></span>Kurser
            </h2>
            <p class="text-muted mb-0">Hantera alla kurser i systemet</p>
        </div>
    </div>

    @if (courses is null)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Laddar...</span>
            </div>
        </div>
    }
    else if (!courses.Any())
    {
        <div class="alert alert-info">
            <span class="bi bi-info-circle me-2"></span>
            Inga kurser hittades.
        </div>
    }
    else
    {
        <CoursesSection Courses="courses"
                        OnView="GoToDetails"
                        OnEdit="OpenEditModal" />
    }
</div>

<!-- EDIT MODAL -->
<EditCourseModal Show="showEditModal"
                 FormModel="formModel"
                 OnSave="HandleUpdate"
                 OnClose="CloseEditModal"
                 IsSaving="isSaving"
                 ErrorMessage="@formError" />

@code {
    private List<CourseListDto>? courses;

    private bool showEditModal;
    private bool isSaving;
    private string? formError;

    private CourseUpdateDto formModel = new();

    protected override async Task OnInitializedAsync()
    {
        courses = await ApiService.GetAsync<List<CourseListDto>>("api/course/list");
    }

    private void OpenEditModal(CourseListDto course)
    {
        formModel = new CourseUpdateDto
        {
            Id = course.Id,
            Name = course.Name,
            Description = course.Description,
            StartDate = course.StartDate,
            EndDate = course.EndDate
        };

        formError = null;
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        formError = null;
    }

    private async Task HandleUpdate()
    {
        isSaving = true;
        formError = null;

        try
        {
            var result = await ApiService.PutAsync<CourseUpdateDto, CourseDto>(
                $"api/course/{formModel.Id}", formModel);

            if (result != null)
            {
                showEditModal = false;
                courses = await ApiService.GetAsync<List<CourseListDto>>("api/course/list");
            }
            else
            {
                formError = "Kunde inte uppdatera kursen.";
            }
        }
        catch (Exception ex)
        {
            formError = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void GoToDetails(int courseId)
    {
        Navigation.NavigateTo($"/teacher/courses/{courseId}");
    }
}
