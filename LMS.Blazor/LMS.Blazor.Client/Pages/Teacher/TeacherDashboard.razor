@page "/teacher/dashboard"
@using LMS.Blazor.Client.Components.Teacher
@using LMS.Shared.DTOs.TeacherDashboard
@using LMS.Shared.DTOs.Course
@inject IApiService ApiService
@inject NavigationManager Nav

<div class="container py-4">
    <h1 class="h3 mb-4">Lärarens Dashboard</h1>

    <!-- Snabbåtgärder -->
    <div class="card shadow-sm mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Snabbåtgärder</h5>

            <button class="btn btn-primary d-flex align-items-center"
                    @onclick='() => activeTab = "create"'>
                <i class="bi bi-plus-circle me-2"></i>
                Skapa ny kurs
            </button>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <button class="nav-link @(activeTab == "overview" ? "active text-primary fw-semibold" : "text-dark")"
                    @onclick='() => activeTab = "overview"'>
                Översikt
            </button>
        </li>

        <li class="nav-item">
            <button class="nav-link @(activeTab == "courses" ? "active text-primary fw-semibold" : "text-dark")"
                    @onclick='() => activeTab = "courses"'>
                Kurser
            </button>
        </li>

        <li class="nav-item">
            <button class="nav-link @(activeTab == "create" ? "active text-primary fw-semibold" : "text-dark")"
                    @onclick='() => activeTab = "create"'>
                Skapa ny kurs
            </button>
        </li>
    </ul>

    @if (dashboard == null)
    {
        <p>Laddar...</p>
    }
    else
    {
        @* ---------------- ÖVERSIKT ---------------- *@
        @if (activeTab == "overview")
        {
            <OverviewSection Dashboard="dashboard" />
        }

        @* ---------------- KURSER ---------------- *@
        else if (activeTab == "courses")
        {
            <CoursesSection Courses="allCourses"
                            OnView="GoToCourse"
                            OnEdit="OpenEditModal" />
        }

        @* ---------------- SKAPA NY KURS ---------------- *@
        else if (activeTab == "create")
        {
            <button class="btn btn-primary"
                    @onclick='() => Nav.NavigateTo("/teacher/courses/create")'>
                Öppna formulär
            </button>
        }
    }
</div>

<!-- EDIT MODAL COMPONENT -->
<EditCourseModal Show="showEditModal"
                 FormModel="formModel"
                 OnSave="SaveChanges"
                 OnClose="CloseEditModal"
                 IsSaving="isSaving"
                 ErrorMessage="@errorMessage" />

@code {
    private TeacherDashboardDto? dashboard;
    private List<CourseListDto> allCourses = new();
    private string activeTab = "overview";

    private bool showEditModal;
    private bool isSaving;
    private string? errorMessage;

    private CourseUpdateDto formModel = new();

    protected override async Task OnInitializedAsync()
    {
        dashboard = await ApiService.GetAsync<TeacherDashboardDto>(
            "api/user/me/teacher-dashboard"
        );

        allCourses = await ApiService.GetAsync<List<CourseListDto>>(
            "api/course/list"
        );
    }

    private void GoToCourse(int id)
    {
        Nav.NavigateTo($"/teacher/courses/{id}");
    }

    private void OpenEditModal(CourseListDto course)
    {
        formModel = new CourseUpdateDto
        {
            Id = course.Id,
            Name = course.Name,
            Description = course.Description,
            StartDate = course.StartDate,
            EndDate = course.EndDate
        };

        errorMessage = null;
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        errorMessage = null;
    }

    private async Task SaveChanges()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            var result = await ApiService.PutAsync<CourseUpdateDto, CourseDto>(
                $"api/course/{formModel.Id}", formModel);

            if (result != null)
            {
                showEditModal = false;
                allCourses = await ApiService.GetAsync<List<CourseListDto>>("api/course/list");
            }
            else
            {
                errorMessage = "Kunde inte uppdatera kursen.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}
